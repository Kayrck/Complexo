# Copie para .env e preencha quando o banco/credenciais reais existirem.
# Sem isso, o backend sobe normalmente e todas as rotas de dados respondem
# 501 (not_implemented) — veja src/middleware/notImplemented.ts.

PORT=4000
NODE_ENV=development

# Postgres. No docker-compose isso já aponta pro serviço "db".
DATABASE_URL=postgresql://complexo:complexo@localhost:5432/complexo?schema=public

# Segredo usado para assinar tokens de sessão (JWT) quando o login for implementado.
JWT_SECRET=change-me

# Origem permitida para CORS (URL do frontend).
CORS_ORIGIN=http://localhost:5173
