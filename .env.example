# Variáveis usadas pelo docker-compose.yml. Copie para ".env" e ajuste
# quando o banco/credenciais reais existirem — sem isso, os defaults abaixo
# são usados e o backend sobe do mesmo jeito (rotas de dados ficam em 501).

POSTGRES_USER=complexo
POSTGRES_PASSWORD=complexo
POSTGRES_DB=complexo

DATABASE_URL=postgresql://complexo:complexo@db:5432/complexo?schema=public
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:8080
